{
    "name":  "harborx",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "frontend",
                       "backend"
                   ],
    "scripts":  {
                    "dev":  "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
                    "build":  "npm run build -w frontend",
                    "start":  "npm run start -w backend",
                    "seed":  "npm run seed -w backend",
                    "test":  "npm run test -w frontend \u0026\u0026 npm run test -w backend",
                    "create-admin":  "npm run create-admin -w backend",
                    "format":  "prettier --write frontend/src backend/src/*.js backend/scripts backend/tests scripts *.json frontend/*.js",
                    "test:pwa":  "npm run build \u0026\u0026 npm run test:pwa -w frontend"
                },
    "devDependencies":  {
                            "concurrently":  "^10.0.6",
                            "prettier":  "3.6.2"
                        },
    "engines":  {
                    "node":  "\u003e=22"
                }
}
