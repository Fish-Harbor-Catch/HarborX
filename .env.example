# HarborX Root Docker Environment Configuration
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)

# PostgreSQL Database Configuration
POSTGRES_DB=harborx
POSTGRES_USER=harborx
POSTGRES_PASSWORD=harborx_secure_password_replace_in_production

# HarborX Application Security & Secrets
# JWT_SECRET must be at least 32 characters long in production
JWT_SECRET=harborx_super_secret_jwt_key_32_characters_minimum!

# Application Port (Production default: 5000, Dev default: 5050)
PORT=5000

# Client Origin (CORS and Allowed Hosts)
# For local Docker HTTP testing, use http://localhost:5000 or http://127.0.0.1:5000
# For HTTPS deployment, use https://${HARBORX_DOMAIN}
CLIENT_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Business Rules
COMMISSION_RATE=5
PAYMENT_DUE_HOURS=48

# Cookie Security (set to "false" for local HTTP, "true" for production HTTPS)
COOKIE_SECURE=false

# Seeding & Demo mode ("false" for production, "true" for development demo)
DEMO_SEED=false

# Domain name for HTTPS proxy (required when using compose.https.yaml)
# HARBORX_DOMAIN=harborx.example.com

# Initial Admin User (used with: docker compose run --rm app npm run create-admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@harborx.local
ADMIN_PASSWORD=AdminPassword123!
