# Copy to backend/.env. Local demo runs without this file.
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Leave blank for a persistent embedded PostgreSQL demo database in backend/data.
# Set this for a normal PostgreSQL server (recommended for deployment):
DATABASE_URL=
# DATABASE_URL=postgresql://harborx:YOUR_PASSWORD@localhost:5432/harborx
JWT_SECRET=
# Set a random secret with at least 32 characters before deploying.
COMMISSION_RATE=5
PAYMENT_DUE_HOURS=48
# Secure cookies default to true in production. Use false only for local HTTP testing.
# COOKIE_SECURE=true
# Enable only on a database dedicated to local demonstration.
DEMO_SEED=true
# Optional, required only by npm run create-admin (never committed):
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
